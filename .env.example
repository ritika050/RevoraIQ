# RevoralQ local configuration
# Copy to .env if you want to override defaults.

APP_NAME=RevoralQ
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional. If unset, the local deterministic reasoning engine is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SQLite database path
DATABASE_PATH=data/revoralq.db
RAW_ARCHIVE_PATH=data/raw

# CORS
FRONTEND_ORIGIN=http://localhost:5173
